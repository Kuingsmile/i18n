{
  "name": "@piclist/i18n",
  "version": "1.0.0",
  "description": "i18n tool",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "rollup -c --watch",
    "build": "rollup -c",
    "lint": "eslint --fix",
    "clean": "rimraf ./dist",
    "lint:check": "eslint",
    "prepublishOnly": "yarn run clean && yarn run build",
    "test": "mocha ./test/index.js",
    "cz": "npm run lint && git-cz",
    "release": "yarn run build && bump-version"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kuingsmile/i18n.git"
  },
  "author": "Kuingsmile",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Kuingsmile/i18n/issues"
  },
  "husky": {
    "hooks": {
      "pre-commit": "yarn run lint",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "./node_modules/node-bump-version/.cz-config.cjs"
    }
  },
  "commitlint": {
    "extends": [
      "./node_modules/node-bump-version/dist/commitlint-node/index.js"
    ]
  },
  "homepage": "https://github.com/Kuingsmile/i18n#readme",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.5",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^20.3.1",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "eslint": "^9.29.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unicorn": "^59.0.1",
    "mocha": "^11.6.0",
    "node-bump-version": "^2.0.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.43.0",
    "rollup-plugin-dts": "^6.2.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0"
  },
  "dependencies": {
    "chalk": "5.4.1",
    "tslib": "^2.8.1"
  }
}
