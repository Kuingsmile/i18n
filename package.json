{
  "name": "@piclist/i18n",
  "version": "2.1.0",
  "description": "i18n tool",
  "homepage": "https://github.com/Kuingsmile/i18n#readme",
  "bugs": {
    "url": "https://github.com/Kuingsmile/i18n/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kuingsmile/i18n.git"
  },
  "license": "MIT",
  "author": "Kuingsmile",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "browser": {
        "import": {
          "types": "./dist/browser.d.ts",
          "default": "./dist/browser.js"
        },
        "require": {
          "types": "./dist/browser.d.cts",
          "default": "./dist/browser.cjs"
        }
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "browser": "./dist/browser.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "benchmark": "npm run build && node benchmark/index.mjs",
    "build": "rollup -c",
    "clean": "rimraf ./dist",
    "cz": "npm run lint && git-cz",
    "dev": "rollup -c --watch",
    "lint": "eslint --fix",
    "lint:check": "eslint",
    "prepare": "husky",
    "prepublishOnly": "yarn run clean && yarn run build",
    "release": "yarn run build && bump-version",
    "test": "node --test ./test/index.js ./test/translation-regressions.mjs ./test/internationalization.mjs ./test/type-declarations.mjs"
  },
  "config": {
    "commitizen": {
      "path": "cz-customizable"
    },
    "cz-customizable": {
      "config": ".cz-config.cjs"
    }
  },
  "dependencies": {
    "chalk": "6.0.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.5.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "commitizen": "^4.3.2",
    "cz-customizable": "^7.5.4",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "node-bump-version": "^3.0.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.1",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bumpVersion": {
    "preset": "emoji"
  }
}
