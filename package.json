{
  "name": "@piclist/i18n",
  "version": "2.0.0",
  "description": "i18n tool",
  "homepage": "https://github.com/Kuingsmile/i18n#readme",
  "bugs": {
    "url": "https://github.com/Kuingsmile/i18n/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kuingsmile/i18n.git"
  },
  "license": "MIT",
  "author": "Kuingsmile",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "import": "./dist/browser.js",
        "require": "./dist/browser.cjs"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "browser": "./dist/browser.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rollup -c",
    "clean": "rimraf ./dist",
    "cz": "npm run lint && git-cz",
    "dev": "rollup -c --watch",
    "lint": "eslint --fix",
    "lint:check": "eslint",
    "prepublishOnly": "yarn run clean && yarn run build",
    "release": "yarn run build && bump-version",
    "test": "node --test ./test/index.js"
  },
  "husky": {
    "hooks": {
      "pre-commit": "yarn run lint",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "commitlint": {
    "extends": [
      "./node_modules/node-bump-version/dist/commitlint-node/index.js"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "./node_modules/node-bump-version/.cz-config.cjs"
    }
  },
  "dependencies": {
    "chalk": "6.0.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.5.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "node-bump-version": "^2.0.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.1",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
